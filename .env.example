# Copy this file to .env for local runs. On Vercel, set the same names under
# Project Settings > Environment Variables. NEVER put real values in this file.

# Supabase > Project Settings > Database > Connection string > Transaction pooler (port 6543)
DATABASE_URL=

# Long random string, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

GOOGLE_CLIENT_ID=
ALLOWED_DOMAINS=oswalgroup.net
ADMIN_EMAILS=

APP_ENV=prod
APP_TIMEZONE=Asia/Kolkata

# Serverless hosting (Vercel): keep the pool tiny, the Supabase pooler does the real pooling.
DB_POOL_MAX=1
